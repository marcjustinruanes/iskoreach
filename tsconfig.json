{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noEmit": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "types": ["vite/client", "node"]
    },
    "include": ["resources/js/**/*.ts", "resources/js/**/*.tsx", "scripts/**/*.ts", "vite.config.ts", "tailwind.config.ts"]
}
